# tvbox: SD-boot safety + first-boot provisioning (rk3318-android)
on early-init
    # Force the physical HDMI link to Full HD; Auto follows a 4K sink EDID on RK3328.
    setprop persist.vendor.resolution.main 1920x1080@60-1920-2008-2052-2200-1080-1084-1089-1125-5
    # VLC's verbose HTTP diagnostics include expiring IPTV access URLs. Keep app-level redacted logs only.
    setprop log.tag.VLC SILENT
    setprop persist.log.tag.VLC SILENT
    setprop log.tag.libvlc SILENT
    setprop persist.log.tag.libvlc SILENT
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/tvbox-emmc-ro.sh early-init

on init
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/tvbox-emmc-ro.sh init

on post-fs
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/tvbox-emmc-ro.sh post-fs

# Сетевой ADB не включаем автоматически; отладка остаётся на USB с проверкой ключа.

on property:sys.boot_completed=1
    start tvbox_firstboot
    start tvbox_clock
    start tvbox_bootlog

# app_process должен стартовать после подготовки APEX в пространстве имён init.
on property:apexd.status=ready
    start tvbox_bootscreen

service tvbox_bootscreen /system/bin/app_process /system/bin org.tvbox.bootscreen.Main
    user root
    group root graphics audio system
    setenv CLASSPATH /system/framework/tvbox-bootscreen.jar
    seclabel u:r:su:s0
    disabled
    oneshot

service tvbox_clock /system/bin/sh /vendor/bin/tvbox-clock.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled

service tvbox_bootlog /system/bin/sh /vendor/bin/tvbox-bootlog.sh
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

service tvbox_firstboot /system/bin/sh /vendor/bin/tvbox-firstboot.sh
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled


# TorrServer MatriX (web UI + streaming) on :8090, starts at boot
on post-fs-data
    mkdir /data/vendor/torrserver 0770 root root
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/tvbox-restore-wifi.sh

on property:sys.boot_completed=1
    start torrserver

service torrserver /system/bin/torrserver -p 8090 -d /data/vendor/torrserver
    user root
    group root inet net_raw sdcard_rw media_rw
    seclabel u:r:su:s0
    disabled

# tvboxd: root helper for the "Установка" tile (eMMC install/verify/backup/restore) and daily Hypatia
# signature updates; abstract socket "tvboxd", only the installer app (and root/shell) may connect
service tvboxd /system/bin/app_process /system/bin org.tvbox.daemon.Main
    user root
    group root system
    setenv CLASSPATH /system/framework/tvboxd.jar
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start tvboxd

# OTA "с очисткой": clear userdata before it is mounted (marker in misc, see tvbox-wipecheck.sh);
# one-shot eMMC boot from "Питание": give the SD its boot sector back (see tvbox-sdboot.sh)
on fs
    exec u:r:su:s0 root root -- /vendor/bin/tvbox-wipecheck.sh
    exec u:r:su:s0 root root -- /vendor/bin/tvbox-sdboot.sh
