# Общие бинарные шаблоны; ниже — явные исключения для LFS-входов
*.img
*.img.xz
*.tar.zst
*.apk
*.bin
*.class
*.jar
*.zip
*.pyc
__pycache__/

# Локальные артефакты проверки среды на W:
.dev-env/

